generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id                    String    @id @map("_id") @db.VarChar(36)
  name                  String?   @default("") @db.VarChar(100)
  email                 String    @unique(map: "email") @db.VarChar(255)
  date_of_birth         DateTime? @db.Date
  gender                String?   @default("") @db.VarChar(20)
  password              String?   @default("") @db.VarChar(255)
  phone_number          String?   @default("") @db.VarChar(255)
  created_at            DateTime? @default(now()) @db.Timestamp(0)
  updated_at            DateTime? @default(now()) @db.Timestamp(0)
  forgot_password_token String?   @default("") @db.VarChar(100)
  google_id             String?   @default("") @db.VarChar(100)
  verify                Int?      @default(0) @db.TinyInt
  role                  Int?      @default(0) @db.TinyInt

  ConsultantProfiles     ConsultantProfiles?
  StaffProfiles     StaffProfiles?
  Questions             Questions[]
  Appointments  Appointments[]
  Notifications  Notifications[]
  Blogs  Blogs[]
  TestServiceAppointments  TestServiceAppointments[]
  ChatBotHistory ChatBotHistory[]
  ReproductiveCycle ReproductiveCycle[]

  @@index([google_id], map: "idx_google_id")
  @@index([forgot_password_token], map: "idx_forgot_token")
}

enum Topic {
  WOMENS_REPRODUCTIVE_HEALTH
  CONTRACEPTION_AND_FAMILY_PLANNING
  PREGNANCY_AND_MATERNITY_SUPPORT
  STIS
  SEXUAL_HEALTH_AND_GENDER_PSYCHOLOGY
  TESTING_AND_DIAGNOSTIC_SERVICES
}

model ConsultantProfiles {
  id               String   @id @map("_id") @db.VarChar(36)
  user_id          String   @unique @db.VarChar(36)
  specialization_1          Topic    
  specialization_2          Topic?
  certifications   String?  @default("") @db.VarChar(255)
  experienceYears  Int      @default(0) @db.Int
  status           Int      @default(1) @db.TinyInt

  user             Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  Questions        Questions[]
  Appointments  Appointments[]
}

model Questions {
  id             String   @id @map("_id") @db.VarChar(36)

  user_id        String?  @db.VarChar(36)
  consultant_id  String   @db.VarChar(36)
  topic          Topic
  question       String   @db.Text
  answer         String?  @db.Text
  is_public      Boolean  @default(true)
  status         Int      @default(0) @db.TinyInt
  created_at     DateTime @default(now()) @db.Timestamp(0)
  answered_at    DateTime? @db.Timestamp(0)

  user           Users?   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  consultant     ConsultantProfiles @relation(fields: [consultant_id], references: [id], onDelete: Cascade)
  notifications  Notifications?
}

enum BookingStatus {
  PENDING
  ONGOING
  COMPLETED
  CANCELLED
}

enum TimeSlot {
  SLOT_07_08
  SLOT_08_09
  SLOT_09_10
  SLOT_10_11
  SLOT_13_14
  SLOT_14_15
  SLOT_15_16
  SLOT_16_17
}

model Appointments {
  id            String   @id @map("_id") @db.VarChar(36)
  user_id       String   @db.VarChar(36)
  consultant_id String   @db.VarChar(36)
  topic         Topic
  note          String?  @db.Text

  booking_date  DateTime
  time_slot     TimeSlot

  created_at    DateTime @default(now())
  status        BookingStatus @default(PENDING)
  chat_room_id String? @db.VarChar(100)

  user       Users             @relation(fields: [user_id], references: [id])
  consultant ConsultantProfiles @relation(fields: [consultant_id], references: [id])
  notifications  Notifications?
  messages     Messages[]
}

model Messages {
  id             String   @id @map("_id") @db.VarChar(36)
  appointment_id String   @db.VarChar(36)
  sender_id      String   @db.VarChar(36)
  content        String
  created_at     DateTime @default(now())

  appointment    Appointments @relation(fields: [appointment_id], references: [id])
}


enum NotificationType {
  ANSWERED_QUESTION
  APPOINTMENT_REMINDER_30M
  SERVICE_REMINDER_1D
  SYSTEM
  OTHER
}

model Notifications {
  id              String   @id @map("_id") @db.VarChar(36)
  user_id         String   @db.VarChar(36)
  type            NotificationType
  content         String
  is_read         Boolean  @default(false)
  is_sent         Boolean  @default(false)
  scheduled_time  DateTime?

  appointment_id  String?  @unique @db.VarChar(36)
  question_id     String?  @unique @db.VarChar(36)
  test_service_appointment_id   String?  @unique @db.VarChar(36)

  created_at      DateTime @default(now())

  user            Users     @relation(fields: [user_id], references: [id])
  appointment     Appointments? @relation(fields: [appointment_id], references: [id])
  question     Questions? @relation(fields: [question_id], references: [id])
  testServiceAppointment TestServiceAppointments? @relation(fields: [test_service_appointment_id], references: [id])
}


enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Blogs {
  id         String   @id @map("_id") @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  author_name String? @db.VarChar(100)
  title      String?  @db.VarChar(255)
  summary    String?  @db.Text
  content    String?  @db.Text
  section_1  String?  @db.Text
  section_2  String?  @db.Text
  cover_image String? @db.VarChar(255)
  main_image String?  @db.VarChar(255)
  sub_image  String?  @db.VarChar(255)
  created_at DateTime @default(now())
  status     BlogStatus @default(DRAFT)
  
  user       Users    @relation(fields: [user_id], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Payments {
  id              String @id @map("_id") @db.VarChar(36)
  appointment_id  String @db.VarChar(36)
  user_id         String @db.VarChar(36)
  amount          Int
  payos_order_code String @db.VarChar(6) @unique
  status          PaymentStatus  @default(PENDING)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model StaffProfiles {
  id               String   @id @map("_id") @db.VarChar(36)
  user_id          String   @unique @db.VarChar(36)
  specialization   String
  status           Int      @default(1) @db.TinyInt

  user             Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  TestServiceAppointments  TestServiceAppointments[]
}

model TestServices {
  id          String           @id @map("_id") @default(uuid())
  name        String
  code        String           @unique
  description String?
  price       Int
  is_active    Boolean          @default(true)
  created_at   DateTime         @default(now()) @map("created_at")

  testPackageServices TestPackageServices[]
  testResults TestResults[]
}

model TestPackages {
  id            String   @id @map("_id") @db.VarChar(36)
  name          String           @unique
  description   String?
  price         Int
  target_gender  Gender
  level         PackageLevel
  created_at     DateTime         @default(now()) @map("created_at")

  testPackageServices TestPackageServices[]
  testServiceAppointments TestServiceAppointments[] 
}

model TestPackageServices {
  test_package_id String
  test_service_id String

  testPackage   TestPackages   @relation(fields: [test_package_id], references: [id])
  testService   TestServices   @relation(fields: [test_service_id], references: [id])

  @@id([test_package_id, test_service_id])
}

enum Gender {
  male
  female
}

enum PackageLevel {
  basic
  advanced
  full
}

enum TestServiceBookingStatus{
  PENDING
  CHECKIN
  ONGOING
  INPUT_RESULTS
  COMPLETED
  CANCELLED
}

model TestServiceAppointments {
  id            String   @id @map("_id") @db.VarChar(36)
  user_id       String   @db.VarChar(36)
  staff_id      String   @db.VarChar(36)

  package_id    String   @db.VarChar(36)
  note          String?  @db.Text

  booking_date  DateTime
  time_slot     TimeSlot

  created_at    DateTime @default(now())
  status        TestServiceBookingStatus @default(PENDING)

  user       Users             @relation(fields: [user_id], references: [id])
  staff     StaffProfiles   @relation(fields: [staff_id], references: [id])
  testPackage TestPackages @relation(fields: [package_id], references: [id])
  notifications  Notifications?
  testResults   TestResults[]
}

model TestResults {
  id                          String   @id @map("_id") @default(uuid()) @db.VarChar(36)
  test_service_appointment_id String   @db.VarChar(36)
  test_service_id             String   @db.VarChar(36)
  result                      String   @db.Text
  unit                        String?  @db.VarChar(50)
  test_date                   DateTime
  note                        String?  @db.Text

  testServiceAppointment      TestServiceAppointments @relation(fields: [test_service_appointment_id], references: [id])
  testService                 TestServices            @relation(fields: [test_service_id], references: [id])

  @@map("TestResults")
}


enum ChatBotRole{
  user
  model
}

model ChatBotHistory {
  id            String   @id @map("_id") @db.VarChar(36)
  user_id       String   @db.VarChar(36)
  role          ChatBotRole
  message       String
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  status        Int      @default(1) @db.TinyInt

  user       Users             @relation(fields: [user_id], references: [id])
}

enum AiType {
  AI_ASSISTANT
  MENSTRUAL_PREDICTOR
}

model ChatBotConfig {
  id                AiType   @unique @map("_id")
  gemini_key         String   @db.VarChar(255)
  system_instruction String   @db.Text
  temperature       Float    @default(0.3) @db.Float 
  max_output_tokens   Int      @default(2048) @db.Int
  updated_at         DateTime @default(now()) @db.Timestamp(0)
}

model ReproductiveCycle {
  id                String              @id @map("_id") @db.VarChar(36)
  user_id           String              @db.VarChar(36)
  start_period_date DateTime            @db.DateTime(0)
  cycle_length      Int                 @db.Int
  period_length     Int                 @db.Int
  note              String?             @db.Text
  created_at        DateTime            @default(now()) @db.DateTime(0)

  user       Users             @relation(fields: [user_id], references: [id])
  cyclePrediction CyclePrediction?
  cycleStatusLogs CycleStatusLogs[]
}

enum CyclePredictionStatus{
  ACTIVE
  COMPLETED
  SKIPPED
}

model CyclePrediction {
  id                   String             @id @map("_id") @db.VarChar(36)
  cycle_id             String            @unique @db.VarChar(36)
  next_period_date     DateTime          @db.DateTime(0)
  period_end_date      DateTime          @db.DateTime(0)
  ovulation_date       DateTime          @db.DateTime(0)
  fertile_window_start DateTime          @db.DateTime(0)
  fertile_window_end   DateTime          @db.DateTime(0)
  status               CyclePredictionStatus @default(ACTIVE)
  created_at           DateTime          @default(now()) @db.DateTime(0)

  cycle                ReproductiveCycle @relation(fields: [cycle_id], references: [id], onDelete: Cascade)
}

enum CycleLogStatus {
  NORMAL
  NEED_ATTENTION
  NOT_POSITIVE
}

model CycleStatusLogs {
  id          String            @id @map("_id") @db.VarChar(36)
  cycle_id    String            @db.VarChar(36)
  log_date    DateTime          @db.Date
  mood        Int?
  libido      Int?
  stress      Int?
  sleep_hours Float?
  energy      Int?
  status      CycleLogStatus

  note        String?  @db.Text
  created_at  DateTime          @default(now()) @db.DateTime(0)

  cycle       ReproductiveCycle @relation(fields: [cycle_id], references: [id], onDelete: Cascade)
}