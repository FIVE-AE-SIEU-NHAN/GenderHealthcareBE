generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id                    String    @id @map("_id") @db.VarChar(36)
  name                  String?   @default("") @db.VarChar(100)
  email                 String    @unique(map: "email") @db.VarChar(255)
  date_of_birth         DateTime? @db.Date
  gender                String?   @default("") @db.VarChar(20)
  password              String?   @default("") @db.VarChar(255)
  phone_number          String?   @default("") @db.VarChar(255)
  created_at            DateTime? @default(now()) @db.Timestamp(0)
  updated_at            DateTime? @default(now()) @db.Timestamp(0)
  forgot_password_token String?   @default("") @db.VarChar(100)
  google_id             String?   @default("") @db.VarChar(100)
  verify                Int?      @default(0) @db.TinyInt
  role                  Int?      @default(0) @db.TinyInt

  ConsultantProfiles ConsultantProfiles?
  Questions          Questions[]
  Appointments       Appointments[]
  Notifications      Notifications[]
  Blogs              Blogs[]
  ReproductiveCycles ReproductiveCycle[]

  @@index([google_id], map: "idx_google_id")
  @@index([forgot_password_token], map: "idx_forgot_token")
}

enum Topic {
  WOMENS_REPRODUCTIVE_HEALTH
  CONTRACEPTION_AND_FAMILY_PLANNING
  PREGNANCY_AND_MATERNITY_SUPPORT
  STIS
  SEXUAL_HEALTH_AND_GENDER_PSYCHOLOGY
  TESTING_AND_DIAGNOSTIC_SERVICES
}

model ConsultantProfiles {
  id               String  @id @map("_id") @db.VarChar(36)
  user_id          String  @unique @db.VarChar(36)
  specialization_1 Topic
  specialization_2 Topic?
  certifications   String? @default("") @db.VarChar(255)
  experienceYears  Int     @default(0) @db.Int
  status           Int     @default(1) @db.TinyInt

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  Questions    Questions[]
  Appointments Appointments[]
}

model Questions {
  id String @id @map("_id") @db.VarChar(36)

  user_id       String?   @db.VarChar(36)
  consultant_id String    @db.VarChar(36)
  topic         Topic
  question      String    @db.Text
  answer        String?   @db.Text
  is_public     Boolean   @default(true)
  status        Int       @default(0) @db.TinyInt
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  answered_at   DateTime? @db.Timestamp(0)

  user          Users?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  consultant    ConsultantProfiles @relation(fields: [consultant_id], references: [id], onDelete: Cascade)
  notifications Notifications?
}

enum BookingStatus {
  PENDING
  ONGOING
  COMPLETED
  CANCELLED
}

enum TimeSlot {
  SLOT_08_10
  SLOT_10_12
  SLOT_13_15
  SLOT_15_17
}

model Appointments {
  id            String @id @map("_id") @db.VarChar(36)
  user_id       String @db.VarChar(36)
  consultant_id String @db.VarChar(36)
  topic         Topic

  booking_date DateTime
  time_slot    TimeSlot

  created_at     DateTime      @default(now())
  status         BookingStatus @default(PENDING)
  socket_room_id String?       @db.VarChar(100)

  user          Users              @relation(fields: [user_id], references: [id])
  consultant    ConsultantProfiles @relation(fields: [consultant_id], references: [id])
  notifications Notifications?
}

enum NotificationType {
  ANSWERED_QUESTION
  APPOINTMENT_REMINDER_30M
  SERVICE_REMINDER_1D
  SYSTEM
  OTHER
}

model Notifications {
  id             String           @id @map("_id") @db.VarChar(36)
  user_id        String           @db.VarChar(36)
  type           NotificationType
  content        String
  is_read        Boolean          @default(false)
  is_sent        Boolean          @default(false)
  scheduled_time DateTime?

  appointment_id String? @unique @db.VarChar(36)
  question_id    String? @unique @db.VarChar(36)

  created_at DateTime @default(now())

  user        Users         @relation(fields: [user_id], references: [id])
  appointment Appointments? @relation(fields: [appointment_id], references: [id])
  question    Questions?    @relation(fields: [question_id], references: [id])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Blogs {
  id          String     @id @map("_id") @db.VarChar(36)
  user_id     String     @db.VarChar(36)
  author_name String?    @db.VarChar(100)
  title       String?    @db.VarChar(255)
  summary     String?    @db.Text
  content     String?    @db.Text
  section_1   String?    @db.Text
  section_2   String?    @db.Text
  cover_image String?    @db.VarChar(255)
  main_image  String?    @db.VarChar(255)
  sub_image   String?    @db.VarChar(255)
  created_at  DateTime   @default(now())
  status      BlogStatus @default(DRAFT)

  user Users @relation(fields: [user_id], references: [id])
}

model ReproductiveCycle {
  id               String   @id @map("_id") @db.VarChar(36)
  user_id          String   @db.VarChar(36)
  last_period_date DateTime
  cycle_length     Int // Số ngày giữa 2 kỳ kinh nguyệt
  period_length    Int // Số ngày hành kinh
  note             String?  @db.Text
  created_at       DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}
